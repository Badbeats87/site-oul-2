generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin_table_preferences {
  id              String      @id @db.Uuid
  user_id         String      @db.Uuid
  table_name      String      @db.VarChar(100)
  visible_columns Json
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @db.Timestamptz(6)
  admin_users     admin_users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, table_name])
  @@index([user_id])
}

model admin_users {
  id                      String                    @id @db.Uuid
  email                   String                    @unique @db.VarChar(255)
  name                    String                    @db.VarChar(255)
  is_active               Boolean                   @default(true)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @db.Timestamptz(6)
  last_login_at           DateTime?                 @db.Timestamptz(6)
  password_hash           String                    @db.VarChar(255)
  role                    UserRole                  @default(BUYER)
  admin_table_preferences admin_table_preferences[]
  refresh_tokens          refresh_tokens[]

  @@index([email])
  @@index([role, is_active])
}

model discogs_oauth_tokens {
  id                  String    @id @db.Uuid
  access_token        String    @unique @db.VarChar(500)
  access_token_secret String    @db.VarChar(500)
  discogs_username    String?   @db.VarChar(255)
  discogs_user_id     Int?
  is_active           Boolean   @default(true)
  obtained_at         DateTime  @default(now()) @db.Timestamptz(6)
  expires_at          DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @db.Timestamptz(6)

  @@index([discogs_username])
  @@index([is_active, created_at(sort: Desc)])
}

model inventory_hold_audits {
  id          String     @id @db.Uuid
  hold_id     String     @db.Uuid
  from_status HoldStatus
  to_status   HoldStatus
  reason      String?    @db.VarChar(255)
  changed_by  String?    @db.Uuid
  changed_at  DateTime   @default(now()) @db.Timestamptz(6)

  @@index([changed_at(sort: Desc)])
  @@index([hold_id, changed_at(sort: Desc)])
}

model inventory_holds {
  id               String         @id @db.Uuid
  inventory_lot_id String         @db.Uuid
  order_id         String?        @db.Uuid
  session_id       String?        @db.VarChar(255)
  hold_status      HoldStatus     @default(ACTIVE)
  quantity         Int            @default(1)
  expires_at       DateTime       @db.Timestamptz(6)
  released_at      DateTime?      @db.Timestamptz(6)
  released_reason  String?        @db.VarChar(255)
  created_by       String?        @db.Uuid
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @db.Timestamptz(6)
  inventory_lots   inventory_lots @relation(fields: [inventory_lot_id], references: [id], onDelete: Cascade)
  orders           orders?        @relation(fields: [order_id], references: [id])

  @@index([expires_at, hold_status])
  @@index([hold_status, created_at(sort: Desc)])
  @@index([inventory_lot_id, hold_status])
  @@index([order_id, hold_status])
  @@index([session_id, hold_status])
}

model inventory_lots {
  id                 String            @id @db.Uuid
  release_id         String            @db.Uuid
  submission_item_id String?           @db.Uuid
  condition_media    VinylCondition
  condition_sleeve   VinylCondition
  cost_basis         Decimal           @db.Decimal(10, 2)
  list_price         Decimal           @db.Decimal(10, 2)
  sale_price         Decimal?          @db.Decimal(10, 2)
  channel            String?           @db.VarChar(50)
  status             LotStatus         @default(DRAFT)
  sku                String?           @unique @db.VarChar(100)
  internal_notes     String?
  public_description String?
  photo_urls         Json?
  reserved_at        DateTime?         @db.Timestamptz(6)
  sold_at            DateTime?         @db.Timestamptz(6)
  order_id           String?           @db.Uuid
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime          @db.Timestamptz(6)
  listed_at          DateTime?         @db.Timestamptz(6)
  country            String?           @db.VarChar(100)
  format             String?           @db.VarChar(100)
  release_status     String?           @db.VarChar(50)
  styles             String?           @db.VarChar(255)
  inventory_holds    inventory_holds[]
  releases           releases          @relation(fields: [release_id], references: [id])
  submission_items   submission_items? @relation(fields: [submission_item_id], references: [id])
  order_items        order_items[]

  @@index([release_id, status])
  @@index([sku])
  @@index([status, listed_at(sort: Desc)])
}

model market_snapshots {
  id          String       @id @db.Uuid
  release_id  String       @db.Uuid
  source      MarketSource
  stat_low    Decimal?     @db.Decimal(10, 2)
  stat_median Decimal?     @db.Decimal(10, 2)
  stat_high   Decimal?     @db.Decimal(10, 2)
  sample_size Int?
  fetched_at  DateTime     @db.Timestamptz(6)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  releases    releases     @relation(fields: [release_id], references: [id], onDelete: Cascade)

  @@index([release_id, fetched_at(sort: Desc)])
  @@index([source, fetched_at(sort: Desc)])
}

model order_audits {
  id            String      @id @db.Uuid
  order_id      String      @db.Uuid
  from_status   OrderStatus
  to_status     OrderStatus
  change_reason String?     @db.VarChar(255)
  changed_by    String?     @db.Uuid
  changed_at    DateTime    @default(now()) @db.Timestamptz(6)
  orders        orders      @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([changed_at(sort: Desc)])
  @@index([order_id, changed_at(sort: Desc)])
}

model order_items {
  id                String         @id @db.Uuid
  order_id          String         @db.Uuid
  inventory_lot_id  String         @db.Uuid
  price_at_purchase Decimal        @db.Decimal(10, 2)
  release_title     String         @db.VarChar(500)
  release_artist    String         @db.VarChar(500)
  condition_media   VinylCondition
  condition_sleeve  VinylCondition
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  inventory_lots    inventory_lots @relation(fields: [inventory_lot_id], references: [id])
  orders            orders         @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([inventory_lot_id])
  @@index([order_id])
}

model orders {
  id                       String            @id @db.Uuid
  orderNumber              String            @unique @db.VarChar(50)
  buyerEmail               String            @db.VarChar(255)
  buyerName                String?           @db.VarChar(255)
  buyerId                  String?           @db.Uuid
  status                   OrderStatus       @default(CART)
  subtotal                 Decimal           @db.Decimal(10, 2)
  tax                      Decimal           @default(0) @db.Decimal(10, 2)
  shipping                 Decimal           @default(0) @db.Decimal(10, 2)
  total                    Decimal           @db.Decimal(10, 2)
  stripe_payment_intent_id String?           @unique @db.VarChar(255)
  stripe_payment_status    String?           @db.VarChar(50)
  payment_method           String?           @db.VarChar(50)
  shippingAddress          Json?
  sessionId                String?           @db.VarChar(255)
  ipAddress                String?           @db.VarChar(50)
  userAgent                String?           @db.VarChar(500)
  created_at               DateTime          @default(now()) @db.Timestamptz(6)
  updated_at               DateTime          @db.Timestamptz(6)
  checkout_started_at      DateTime?         @db.Timestamptz(6)
  payment_confirmed_at     DateTime?         @db.Timestamptz(6)
  shipped_at               DateTime?         @db.Timestamptz(6)
  delivered_at             DateTime?         @db.Timestamptz(6)
  shipping_method          ShippingMethod?
  inventory_holds          inventory_holds[]
  order_audits             order_audits[]
  order_items              order_items[]
  shipments                shipments?

  @@index([buyerEmail])
  @@index([sessionId])
  @@index([status, created_at(sort: Desc)])
  @@index([stripe_payment_intent_id])
}

model pricing_policies {
  id                       String                     @id @db.Uuid
  name                     String                     @db.VarChar(255)
  scope                    PolicyScope
  is_active                Boolean                    @default(true)
  version                  Int                        @default(1)
  buy_formula              Json
  sell_formula             Json
  condition_curve          Json
  min_offer                Decimal?                   @db.Decimal(10, 2)
  max_offer                Decimal?                   @db.Decimal(10, 2)
  offer_expiry_days        Int                        @default(30)
  genre_scope              String?                    @db.VarChar(100)
  channel_scope            String?                    @db.VarChar(50)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @db.Timestamptz(6)
  created_by               String?                    @db.Uuid
  pricing_policy_audits    pricing_policy_audits[]
  release_pricing_policies release_pricing_policies[]

  @@index([genre_scope, is_active])
  @@index([scope, is_active])
}

model pricing_policy_audits {
  id               String           @id @db.Uuid
  policy_id        String           @db.Uuid
  change_type      String           @db.VarChar(50)
  previous_version Int?
  new_version      Int
  changes          Json
  changed_by       String?          @db.Uuid
  changed_at       DateTime         @default(now()) @db.Timestamptz(6)
  pricing_policies pricing_policies @relation(fields: [policy_id], references: [id], onDelete: Cascade)

  @@index([policy_id, changed_at(sort: Desc)])
}

model refresh_tokens {
  id          String      @id @db.Uuid
  token       String      @unique @db.VarChar(500)
  user_id     String      @db.Uuid
  expires_at  DateTime    @db.Timestamptz(6)
  revoked_at  DateTime?   @db.Timestamptz(6)
  replaced_by String?     @db.Uuid
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  admin_users admin_users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@index([token])
  @@index([user_id])
}

model release_pricing_policies {
  id               String           @id @db.Uuid
  release_id       String           @db.Uuid
  policy_id        String           @db.Uuid
  priority         Int              @default(0)
  is_active        Boolean          @default(true)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @db.Timestamptz(6)
  pricing_policies pricing_policies @relation(fields: [policy_id], references: [id], onDelete: Cascade)
  releases         releases         @relation(fields: [release_id], references: [id], onDelete: Cascade)

  @@unique([release_id, policy_id])
  @@index([release_id, is_active])
}

model releases {
  id                       String                     @id @db.Uuid
  title                    String                     @db.VarChar(500)
  artist                   String                     @db.VarChar(500)
  label                    String?                    @db.VarChar(255)
  catalog_number           String?                    @db.VarChar(100)
  barcode                  String?                    @db.VarChar(50)
  release_year             Int?
  genre                    String?                    @db.VarChar(100)
  cover_art_url            String?                    @db.VarChar(1000)
  description              String?
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @db.Timestamptz(6)
  search_vector            Unsupported("tsvector")?
  discogs_id               Int?                       @unique
  inventory_lots           inventory_lots[]
  market_snapshots         market_snapshots[]
  release_pricing_policies release_pricing_policies[]
  submission_items         submission_items[]

  @@index([artist, title])
  @@index([barcode])
  @@index([catalog_number])
  @@index([created_at])
  @@index([discogs_id])
  @@index([genre])
  @@index([genre, release_year])
  @@index([release_year])
}

model seller_submissions {
  id                String              @id @db.Uuid
  seller_contact    String              @db.VarChar(255)
  seller_name       String?             @db.VarChar(255)
  seller_notes      String?
  status            SubmissionStatus    @default(PENDING_REVIEW)
  total_offered     Decimal?            @db.Decimal(10, 2)
  total_accepted    Decimal?            @db.Decimal(10, 2)
  channel           String?             @db.VarChar(50)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @db.Timestamptz(6)
  expires_at        DateTime            @db.Timestamptz(6)
  reviewed_at       DateTime?           @db.Timestamptz(6)
  reviewed_by       String?             @db.Uuid
  submission_audits submission_audits[]
  submission_items  submission_items[]

  @@index([expires_at])
  @@index([seller_contact])
  @@index([status, created_at(sort: Desc)])
}

model shipment_tracking {
  id               String    @id @db.Uuid
  shipment_id      String    @db.Uuid
  status           String    @db.VarChar(50)
  status_detail    String?   @db.VarChar(255)
  location         String?   @db.VarChar(255)
  event_time       DateTime  @db.Timestamptz(6)
  message          String?
  carrier_event_id String?   @db.VarChar(100)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  shipments        shipments @relation(fields: [shipment_id], references: [id], onDelete: Cascade)

  @@index([shipment_id, event_time(sort: Desc)])
}

model shipments {
  id                      String              @id @db.Uuid
  order_id                String              @unique @db.Uuid
  shipment_status         ShipmentStatus      @default(PENDING_LABEL)
  carrier                 ShippingCarrier
  shipping_method         ShippingMethod
  tracking_number         String?             @unique @db.VarChar(100)
  tracking_url            String?             @db.VarChar(500)
  label_url               String?             @db.VarChar(500)
  label_format            String?             @db.VarChar(20)
  weight_oz               Int
  packageType             String              @default("PACKAGE") @db.VarChar(50)
  dimensions              Json?
  base_rate               Decimal             @db.Decimal(10, 2)
  insurance_cost          Decimal             @default(0) @db.Decimal(10, 2)
  total_cost              Decimal             @db.Decimal(10, 2)
  from_address            Json
  to_address              Json
  provider_shipment_id    String?             @db.VarChar(100)
  provider_rate_id        String?             @db.VarChar(100)
  provider_metadata       Json?
  approved_for_shipment   Boolean             @default(false)
  approved_by             String?             @db.Uuid
  approved_at             DateTime?           @db.Timestamptz(6)
  packed_by               String?             @db.Uuid
  packed_at               DateTime?           @db.Timestamptz(6)
  estimated_delivery_date DateTime?           @db.Timestamptz(6)
  actual_delivery_date    DateTime?           @db.Timestamptz(6)
  signature_required      Boolean             @default(false)
  created_at              DateTime            @default(now()) @db.Timestamptz(6)
  updated_at              DateTime            @db.Timestamptz(6)
  shipped_at              DateTime?           @db.Timestamptz(6)
  shipment_tracking       shipment_tracking[]
  orders                  orders              @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([carrier, shipment_status])
  @@index([shipment_status, created_at(sort: Desc)])
  @@index([tracking_number])
}

model shipping_rates {
  id              String          @id @db.Uuid
  zone_id         String          @db.Uuid
  shipping_method ShippingMethod
  carrier         ShippingCarrier
  min_weight_oz   Int
  max_weight_oz   Int
  base_rate       Decimal         @db.Decimal(10, 2)
  per_oz_rate     Decimal         @default(0) @db.Decimal(10, 4)
  min_days        Int
  max_days        Int
  effective_date  DateTime        @default(now()) @db.Timestamptz(6)
  expiration_date DateTime?       @db.Timestamptz(6)
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @db.Timestamptz(6)
  shipping_zones  shipping_zones  @relation(fields: [zone_id], references: [id], onDelete: Cascade)

  @@index([min_weight_oz, max_weight_oz])
  @@index([zone_id, shipping_method, is_active])
}

model shipping_zones {
  id              String           @id @db.Uuid
  name            String           @unique @db.VarChar(100)
  description     String?
  states_included String[]
  zip_ranges      Json?
  priority        Int              @default(0)
  is_active       Boolean          @default(true)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @db.Timestamptz(6)
  shipping_rates  shipping_rates[]

  @@index([priority, is_active])
}

model submission_audits {
  id                 String             @id @db.Uuid
  submission_id      String             @db.Uuid
  from_status        SubmissionStatus
  to_status          SubmissionStatus
  change_reason      String?            @db.VarChar(255)
  changed_by         String?            @db.Uuid
  changed_at         DateTime           @default(now()) @db.Timestamptz(6)
  seller_submissions seller_submissions @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@index([changed_at(sort: Desc)])
  @@index([submission_id, changed_at(sort: Desc)])
}

model submission_items {
  id                      String             @id @db.Uuid
  submission_id           String             @db.Uuid
  release_id              String             @db.Uuid
  quantity                Int                @default(1)
  seller_condition_media  VinylCondition
  seller_condition_sleeve VinylCondition
  auto_offer_price        Decimal            @db.Decimal(10, 2)
  counter_offer_price     Decimal?           @db.Decimal(10, 2)
  final_offer_price       Decimal?           @db.Decimal(10, 2)
  policy_id_used          String?            @db.Uuid
  policy_version_used     Int?
  status                  ItemStatus         @default(PENDING)
  notes                   String?
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  updated_at              DateTime           @db.Timestamptz(6)
  inventory_lots          inventory_lots[]
  releases                releases           @relation(fields: [release_id], references: [id])
  seller_submissions      seller_submissions @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@index([release_id])
  @@index([status])
  @@index([submission_id])
}

enum HoldStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONVERTED_TO_SALE
}

enum ItemStatus {
  PENDING
  ACCEPTED
  COUNTER_OFFERED
  REJECTED
  CONVERTED_TO_INVENTORY
}

enum LotStatus {
  DRAFT
  LIVE
  RESERVED
  SOLD
  REMOVED
  RETURNED
}

enum MarketSource {
  DISCOGS
  EBAY
  HYBRID
  MANUAL
}

enum OrderStatus {
  CART
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  REFUNDED
}

enum PolicyScope {
  GLOBAL
  GENRE
  RELEASE
  CHANNEL
  BUYER
  SELLER
}

enum ShipmentStatus {
  PENDING_LABEL
  LABEL_GENERATED
  READY_TO_SHIP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  EXCEPTION
}

enum ShippingCarrier {
  MOCK
  USPS
  UPS
  FEDEX
  DHL
}

enum ShippingMethod {
  STANDARD
  EXPRESS
  OVERNIGHT
}

enum SubmissionStatus {
  PENDING_REVIEW
  COUNTER_OFFERED
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  EXPIRED
  COMPLETED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SELLER
  BUYER
}

enum VinylCondition {
  MINT
  NM
  VG_PLUS
  VG
  VG_MINUS
  G
  FAIR
  POOR
}
